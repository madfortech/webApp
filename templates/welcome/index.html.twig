{% extends 'base.html.twig' %}

{% block title %}Welcome!{% endblock %}

{% block body %}
 
<div class="flex gap-[20px] justify-center">
    <div class="lg:w-[50%] mt-10 py-10 px-20">
        <h1 class="text-2xl font-bold">
            Your video chats are <span class="text-blue-500">private</span> and <span class="text-blue-500">secure</span> with end-to-end 
            encryption— <span class="text-blue-500">no one else</span> can see or hear them.
        </h1>
        <a href="{{ path('app_login') }}" class="mt-10 block text-center py-2 font-bold capitalize text-white bg-blue-500 px-5 rounded">
            let's get started
        </a>
    </div>
</div>

{% endblock %}
