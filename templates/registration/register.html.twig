{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}

<div class="mt-5 mb-5 p-5 max-w-2xl mx-auto">     

    {% for flash_error in app.flashes('verify_email_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}

    <h1 class="text-7xl font-bold mb-4">Register</h1>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
        <div class="mb-3">
            {{ form_row(registrationForm.name, {
                label: 'Name',
                attr: {
                    class: 'w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500'
                }
            }) }}
        </div>
        <div class="mb-3">
            {{ form_row(registrationForm.email, {
                label: 'Email',
                attr: {
                    class: 'w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500'
                }
            }) }}
        </div>
        <div class="mb-3">
            {{ form_row(registrationForm.plainPassword, {
                label: 'Password',
                attr: {
                    class: 'w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500'
                }
            }) }}
        </div>
        <div class="mb-3">
            {{ form_row(registrationForm.agreeTerms, {
                label: 'Agree to terms and conditions'
            }) }}
        </div>

        <div class="mb-3">
            <button type="submit" class="bg-blue-500 text-white w-full px-4 py-2 rounded hover:bg-blue-600">
                Register
            </button>
        </div>
    {{ form_end(registrationForm) }}

    <div class="text-center mt-4">
        Already have an account? <a href="{{ path('app_login') }}" class="text-blue-500 hover:underline">Login</a>
    </div>
</div>
{% endblock %}
