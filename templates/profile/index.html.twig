{% extends 'base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block body %}
 
<div class="lg:flex gap-[20px] container mx-auto py-6 px-4 border border-gray-300 max-w-7xl mt-4">

  
    <div data-controller="sidemenu" class="w-[200px]">
        <h1 class="text-2xl font-bold py-2 px-4 border-b border-gray-300 mb-2">Settings</h1>
        {% include 'sidebar/side-menu.html.twig' %}
    </div>
    <div class="lg:grow shrink-[10] order-1">
        {# Profile form #}
        {% include 'profile/edit.html.twig' with {
            'user': user, 
            'editProfileForm': editProfileForm 
        } %}

        {# Delete Account #}
        <div class="py-2 px-3">
            
            <form action="{{ path('app_profile_delete', {'id': user.id}) }}" method="post" 
                onsubmit="return confirm('Are you sure you want to delete your profile?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded">
                    Delete Account
                </button>
            </form> 
        </div>
        {# Delete Account #}
    </div>
    <div class="lg:bg-gray-200 lg:w-[200px] w-[200px] h-[10vh]">
        <h2 class="text-2xl font-bold py-2 px-4 border-b border-gray-300 mb-2">Profile</h2>
    </div>
</div>
 
{% endblock %}
