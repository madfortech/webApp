<div class="max-w-7xl py-5 px-5">
    <div>
        {{ form_start(form) }}
        <div class="mb-5">
            {{ form_row(form.question,{
                label: 'Question',
                attr: {
                    class: 'w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500'
                }
            }) }}
        </div>

        <div class="mb-5">   
            {{ form_row(form.answer,{
                label: 'Answer',
                attr: {
                    class: 'w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500'
                }
            }) }}
            
        </div>

        <div class="mb-5">
            <button class="bg-[#1e40af] w-full text-white px-5 py-2">
                {{ button_label|default('Save') }}

            </button>
        </div>
        {{ form_end(form) }}
    </div>
</div>
