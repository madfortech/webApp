{% extends 'base.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block body %}

<div class="container mt-5 mb-5 mx-auto w-1/2"> 
    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}
    <h1 class="text-2xl font-bold mb-4">Reset your password</h1>

    {{ form_start(requestForm) }}
        {{ form_row(requestForm.email, {
            label: 'Email',
            'attr': {
                'class': 'w-full px-4 py-2 border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500',
            },
        }) }}
        <div>
            <small>
                Enter your email address, and we will send you a
                link to reset your password.
            </small>
        </div>

        <div class="mb-3">  
            <button class="bg-blue-500 text-white w-full px-4 py-2 rounded hover:bg-blue-600" type="submit">
                Send password reset email
            </button>
        </div>
    {{ form_end(requestForm) }}
</div>
{% endblock %}
